# ── Network ───────────────────────────────────────────────────────────────
# HyperDex runs on Stellar Testnet only.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ── Token addresses (Stellar Asset Contract / SAC addresses) ────────────────
# Circle testnet USDC and EURC (Stellar Asset Contract addresses).
USDC_CONTRACT_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
EURC_CONTRACT_ADDRESS=CCUUDM434BMZMYWYDITHFXHDMIVTGGD6T2I5UKNX5BSLXLW7HVR4MCGZ

# ── Contract addresses (network-specific, set at deploy time) ───────────────
POOL_REGISTRY_CONTRACT_ADDRESS=CA4VDATAXPCSAJSDSTEZSCLVLIWMT6PYS5WJYITBQZWZ6JAFNP3Q5HNW
QUOTE_VERIFIER_CONTRACT_ADDRESS=CAJ4UIEWD43ZH4F4HIL2NMPKZKLF5OHWNVJUUDQA2RH6A72ZRQVCCYS5
MAKER_POOL_FACTORY_ADDRESS=CAAQHM5YQUXIL62EJKVSXZDK45GIV4ZSTG4UAS5QFBQJN4ZSDDNXZWXD

# ── Maker credentials (populated by `npm run setup`) ────────────────────────
MAKER_API_KEY=
SIGNER_PRIVATE_KEY=<64-char hex seed from generate-keypair.ts>
MAKER_ADDRESS=G...
POOL_ADDRESS=
MAKER_NAME=My Maker
PORT=3001

# ── Backend ─────────────────────────────────────────────────────────────────
# The HyperDex testnet backend.
BACKEND_WS_URL=wss://<testnet-backend-host>/ws/maker
BACKEND_HTTP_URL=https://<testnet-backend-host>
